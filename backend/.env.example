APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# full for local/standard images; render_free is baked into Dockerfile.free
DEPLOYMENT_PROFILE=full

# Dataset — never load the full 55–56 GB corpus into RAM
DATASET_ID=ai4bharat/MSMARCO-XI
DATASET_CONFIG=hi
DATASET_SPLIT=validation
INDEX_ENGLISH=true
INDEX_TRANSLATED=true

INGEST_MODE=subset
MAX_DOCUMENTS=500
BATCH_SIZE=64
CHECKPOINT_PATH=../data/checkpoints/ingest.json
INGEST_MAX_BATCH_RETRIES=2
INGEST_CHECKPOINT_ID_WINDOW=50000
INGEST_STOP_ON_BATCH_FAILURE=true

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hh_goa_rag
QDRANT_API_KEY=
QDRANT_TIMEOUT_S=30
# Hosted inference model for RETRIEVAL_MODE=cloud_dense_sparse (must match prod collection)
QDRANT_INFERENCE_MODEL=intfloat/multilingual-e5-small
QDRANT_INFERENCE_DIMENSION=384
VOICE_RATE_LIMIT_PER_MINUTE=20

# Runtime profiles
# local = Torch SentenceTransformers + optional generative ElevenLabs
# cloud_dense_sparse = Qdrant Cloud inference + BM25 (Render Free; no Torch)
RETRIEVAL_MODE=local
# generative = ElevenLabs LLM; extractive = source-sentence composition
ANSWER_MODE=generative

# Local multilingual embeddings (configurable; dimension is read from the model)
# Fast default: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384d)
# Stronger retrieval: intfloat/multilingual-e5-small (384d)
# Highest quality / heavier: BAAI/bge-m3 (1024d)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu

# Multilingual MS MARCO cross-encoder. Alternative: BAAI/bge-reranker-v2-m3
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_DEVICE=cpu
ENABLE_RERANKER=false

DENSE_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=20
RERANK_TOP_K=5
FUSION_METHOD=rrf
RRF_K=60
PARALLEL_RETRIEVAL=true

CHUNK_STRATEGY=sentence
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEMANTIC_SIMILARITY_THRESHOLD=0.35

MAX_CONTEXT_CHARS=6000
MAX_QUERY_CHARS=2000
RELEVANCE_MIN_RESULTS=1
RELEVANCE_MIN_SCORE=0.01
GROUNDING_MIN_OVERLAP=0.20

BM25_INDEX_PATH=../data/indexes/bm25.pkl

ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_MODEL=gemini-2.0-flash
ELEVENLABS_AGENT_ID=
ELEVENLABS_TIMEOUT_S=30
ELEVENLABS_MAX_RETRIES=3

# Stage 3 ElevenLabs Speech-to-Text
ELEVENLABS_STT_MODEL=scribe_v2
MAX_AUDIO_SIZE_MB=20
ELEVENLABS_STT_TIMEOUT_S=30
ELEVENLABS_STT_MAX_RETRIES=3
VOICE_BENCHMARK_QUERIES=20

BENCHMARK_QUERIES=100
BENCHMARK_WARMUP_QUERIES=3
BENCHMARK_INCLUDE_GENERATION=true
BENCHMARK_OUTPUT_DIR=../benchmarks
EVAL_QUERIES=50
EMBEDDING_EVAL_MODELS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2,intfloat/multilingual-e5-small
HF_HOME=
