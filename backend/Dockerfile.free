FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WEB_CONCURRENCY=1 \
    DEPLOYMENT_PROFILE=render_free \
    RETRIEVAL_MODE=cloud_dense_sparse \
    ANSWER_MODE=extractive \
    QDRANT_COLLECTION=hh_goa_voice_rag_prod \
    QDRANT_INFERENCE_MODEL=intfloat/multilingual-e5-small \
    QDRANT_INFERENCE_DIMENSION=384

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-deploy-free.txt /app/backend/requirements-deploy-free.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /app/backend/requirements-deploy-free.txt

COPY backend/app /app/backend/app
COPY backend/rag /app/backend/rag
COPY backend/evaluation /app/backend/evaluation
COPY data/indexes/bm25.pkl /app/data/indexes/bm25.pkl

WORKDIR /app/backend
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl --fail http://127.0.0.1:${PORT:-8000}/health || exit 1

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
